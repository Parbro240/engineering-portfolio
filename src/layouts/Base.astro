---
import '../styles/global.css';
import {profile, href} from '../lib/content';
interface Props { title?: string; description?: string; noindex?: boolean; }
const {title = `${profile.name} | ${profile.discipline}`, description = "I'm Parker Cole, a Mechanical & Aerospace Engineering Student at Oklahoma State University. View my design projects, prototypes, and Peterbilt internship work.", noindex = false} = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL(href('social-preview.png'), Astro.site).href : undefined;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>document.documentElement.classList.replace('no-js','js');</script>
  <title>{title}</title><meta name="description" content={description} />
  <meta name="theme-color" content="#202523" />
  {noindex && <meta name="robots" content="noindex" />}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Parker Cole · Engineering Portfolio" />
  {canonical && <meta property="og:url" content={canonical} />}
  {socialImage && <><meta property="og:image" content={socialImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Parker Cole, Mechanical & Aerospace Engineering Student at Oklahoma State University." /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={socialImage} /></>}
  <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header"><div class="header-inner">
    <a class="brand" href={href()}><span class="brand-mark" aria-hidden="true">PC<span>.</span></span><span>Parker Cole<span class="brand-sub">Engineering Portfolio</span></span><span class="sr-only"> home</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu <span aria-hidden="true">+</span></button>
    <nav id="main-nav" class="main-nav" aria-label="Main navigation">
      <a href={href('work/')}>Projects</a><a href={href('#experience')}>Experience</a><a href={href('#about')}>About</a><a href={href('#contact')}>Contact</a>
      <a class="nav-resume" href={href('resume.pdf')} target="_blank" rel="noopener">View Resume <span class="sr-only">(PDF, opens in a new tab)</span><span aria-hidden="true">↗</span></a>
    </nav>
  </div></header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="site-footer"><div class="container footer-inner"><a href={href()}>{profile.name}<span>{profile.discipline}</span></a><span>Oklahoma State University</span><a href={href('resume.pdf')} download="Parker_Cole_Resume.pdf">Download Resume <span aria-hidden="true">↓</span></a></div></footer>
  <dialog id="image-dialog" aria-label="Enlarged project image"><div class="dialog-toolbar"><p id="dialog-caption"></p><button type="button" id="close-image">Close <span aria-hidden="true">×</span></button></div><img id="dialog-image" alt="" /></dialog>
  <script>
    const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('#main-nav');
    if(menu && nav){
      menu.classList.add('enhanced'); nav.classList.add('enhanced');
      const close = () => {menu.setAttribute('aria-expanded','false'); nav.classList.remove('is-open');};
      menu.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); nav.classList.toggle('is-open', open); });
      nav.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
      document.addEventListener('keydown', event => {if(event.key === 'Escape' && menu.getAttribute('aria-expanded') === 'true'){close(); menu.focus();}});
      document.addEventListener('click', event => {if(event.target instanceof Node && !nav.contains(event.target) && !menu.contains(event.target)) close();});
      matchMedia('(min-width: 761px)').addEventListener('change', event => { if(event.matches) close(); });
    }
    const dialog = document.querySelector<HTMLDialogElement>('#image-dialog');
    const dialogImage = document.querySelector<HTMLImageElement>('#dialog-image');
    const caption = document.querySelector('#dialog-caption');
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach(link => link.addEventListener('click', event => {
      if(event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || !dialog || !dialogImage || !caption) return;
      event.preventDefault(); opener = link; dialogImage.src = link.href; dialogImage.alt = link.querySelector('img')?.alt || ''; caption.textContent = link.dataset.caption || '';
      dialog.showModal(); document.body.classList.add('dialog-open');
    }));
    document.querySelector('#close-image')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', event => {if(event.target === dialog) dialog.close();});
    dialog?.addEventListener('close', () => {document.body.classList.remove('dialog-open'); opener?.focus(); if(dialogImage) dialogImage.removeAttribute('src');});
  </script>
</body>
</html>
