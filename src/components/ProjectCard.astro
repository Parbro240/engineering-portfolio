---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
import { href } from '../lib/content';
interface Props { project: CollectionEntry<'projects'>; index?: number; }
const {project, index = 0} = Astro.props;
const p = project.data;
---
<article class="project-card">
  <a class="project-card-link" href={href(`work/${project.id}/`)}>
    <ProjectVisual src={p.coverImage} alt={p.coverAlt} placeholder={p.coverPlaceholder} metric={p.metric} />
    <div class="project-card-copy">
      <div class="project-topline"><span class="eyebrow">{p.categories.join(' · ')}</span><span class="project-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span></div>
      <h3>{p.title}</h3>
      <p>{p.subtitle}</p>
      <span class="project-link-label">View Case Study <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
