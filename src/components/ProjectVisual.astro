---
import { Image } from 'astro:assets';
import { projectImage } from '../lib/images';
interface Props { src?: string; alt?: string; placeholder?: string; metric?: boolean; compact?: boolean; }
const { src, alt = '', placeholder = 'Project image to be added', metric = false, compact = false } = Astro.props;
const image = src ? projectImage(src) : null;
---
<div class:list={['project-visual', { 'metric-visual': metric && !image, compact }]}>
  {image ? <Image src={image} alt={alt} widths={[480, 800, 1200, 1600].filter(w => w <= image.width)} sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 50vw, 600px" format="webp" quality={85} loading="lazy" /> : metric ? <div class="metric-content"><span class="eyebrow">Drawing information retrieval</span><div class="metric-pair"><span>5<span class="unit">min</span></span><span class="metric-arrow" aria-label="reduced to">→</span><span>1<span class="unit">min</span></span></div><span class="metric-note">Approximate time per drawing</span></div> : <div class="image-placeholder"><span class="placeholder-rule" aria-hidden="true"></span><span>{placeholder}</span><span class="placeholder-sub">{placeholder.includes('confidentiality') ? 'Public case study' : 'Project documentation'}</span></div>}
</div>
