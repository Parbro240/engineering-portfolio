---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {profile, projects, href} from '../lib/content';
const selected = (await projects()).filter(p => p.data.featured);
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow orange">Design · Manufacturing · Prototyping</p><h1 id="hero-title">Parker Cole</h1><p class="hero-discipline">{profile.discipline}</p><p class="hero-university">{profile.university}</p><p class="hero-intro">{profile.intro}</p><div class="button-row"><a class="button primary" href="#work">View Projects <span aria-hidden="true">↓</span></a><a class="button secondary" href={href('resume.pdf')} target="_blank" rel="noopener">View Resume <span class="sr-only">(PDF, opens in a new tab)</span><span aria-hidden="true">↗</span></a></div><a class="hero-contact" href="#contact">Contact Me</a></div>
    <aside class="hero-aside" aria-label="Engineering experience highlights"><span class="eyebrow">Engineering Skills</span><div class="focus-row"><span class="focus-number">01</span><div><h2>Design</h2><p>SolidWorks and Creo Parametric<br />Mechanical design</p></div></div><div class="focus-row"><span class="focus-number">02</span><div><h2>Build</h2><p>Physical prototypes<br />Additive manufacturing</p></div></div><div class="focus-row"><span class="focus-number">03</span><div><h2>Improve</h2><p>Design iteration<br />Assembly and manufacturability</p></div></div><div class="aside-bottom">Peterbilt Motors Company<span>Advanced Manufacturing Engineering Intern · May 2026 – August 2026</span></div></aside>
  </section>
  <div class="credentials container"><div><span>GPA:</span><strong>{profile.gpa}</strong></div><div><span>Expected Graduation:</span><strong>{profile.graduation}</strong></div><div><strong>Certified SolidWorks Associate (CSWA)</strong></div><div><strong>Minor in {profile.minor}</strong></div></div>
  <section class="section container" id="work"><div class="section-heading"><div><p class="eyebrow">01 · Projects</p><h2>Selected Engineering Projects</h2></div><a class="text-link" href={href('work/')}>All Projects <span aria-hidden="true">↗</span></a></div><div class="project-grid featured-grid">{selected.map((project,index) => <ProjectCard project={project} index={index} />)}</div></section>
  <section class="section experience-section" id="experience"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 · Experience</p><h2>Engineering Experience</h2></div></div><div class="experience-list">{profile.experience.map((job,index) => <article class:list={['experience-item', {'primary-experience': index === 0}]}><div class="experience-meta"><p class="eyebrow">{job.date}</p>{job.location && <p>{job.location}</p>}</div><div><h3>{job.company}</h3><p class="job-role">{job.role}</p><ul>{job.points.map(point => <li>{point}</li>)}</ul>{job.project && <a class="text-link" href={href(`work/${job.project}/`)}>View Internship <span aria-hidden="true">↗</span></a>}</div></article>)}</div></div></section>
  <section class="section container about-section" id="about"><div><p class="eyebrow">03 · About</p><h2>About Me</h2><div class="education"><span class="eyebrow">Education</span><h3>{profile.university}</h3><p>{profile.degree}</p><p>Minor in {profile.minor}<br />Expected Graduation: {profile.graduation} · GPA: {profile.gpa}</p></div></div><div class="about-copy">{profile.bio.map(p => <p>{p}</p>)}<a class="text-link" href="#contact">Contact Me <span aria-hidden="true">↗</span></a></div></section>
  <section class="container skills-section" id="skills"><div class="section-heading"><div><p class="eyebrow">Skills</p><h2>Technical and Professional Skills</h2></div></div><div class="skills-grid">{profile.skills.map(group => <div><h3>{group.category}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div></section>
  <section class="section container leadership-section"><div class="section-heading"><div><p class="eyebrow">Activities</p><h2>Leadership and Activities</h2></div></div><div class="leadership-grid">{profile.leadership.map(item => <article><p class="eyebrow">{item.date}</p><h3>{item.name}</h3><p class="leadership-role">{item.role}</p><p>{item.detail}</p></article>)}</div></section>
  <section class="contact-section" id="contact"><div class="container contact-inner"><div><p class="eyebrow">04 · Contact</p><h2>Contact</h2><p>I'm interested in engineering internships in design, manufacturing, and prototyping.</p></div><div class="contact-links"><a href={`mailto:${profile.email}`}><span>Email</span><strong>{profile.email}</strong><span aria-hidden="true">↗</span></a><a href={`tel:${profile.phoneLink}`}><span>Phone</span><strong>{profile.phone}</strong><span aria-hidden="true">↗</span></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><span>Connect</span><strong>LinkedIn<span class="sr-only"> (opens in a new tab)</span></strong><span aria-hidden="true">↗</span></a><a href={href('resume.pdf')} target="_blank" rel="noopener"><span>Resume</span><strong>View Resume<span class="sr-only"> (opens in a new tab)</span></strong><span aria-hidden="true">↗</span></a></div></div></section>
</Base>
