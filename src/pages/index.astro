---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {profile, projects, href} from '../lib/content';
const selected = (await projects()).filter(p => p.data.featured);
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow orange">Design / Manufacturing / Prototyping</p><h1 id="hero-title">Parker Cole<span class="orange">.</span></h1><p class="hero-discipline">{profile.discipline}</p><p class="hero-university">{profile.university}</p><p class="hero-intro">{profile.intro}</p><div class="button-row"><a class="button primary" href="#work">View projects <span aria-hidden="true">↓</span></a><a class="button secondary" href={href('resume.pdf')} target="_blank" rel="noopener">View resume <span class="sr-only">(PDF, opens in a new tab)</span><span aria-hidden="true">↗</span></a></div><a class="hero-contact" href="#contact">Contact me</a></div>
    <aside class="hero-aside" aria-label="Engineering experience highlights"><span class="eyebrow">Engineering in practice</span><div class="focus-row"><span class="focus-number">01</span><div><h2>Design it.</h2><p>SolidWorks & Creo<br />Mechanical design</p></div></div><div class="focus-row"><span class="focus-number">02</span><div><h2>Build it.</h2><p>Physical prototypes<br />Additive manufacturing</p></div></div><div class="focus-row"><span class="focus-number">03</span><div><h2>Improve it.</h2><p>Design iteration<br />Assembly & manufacturability</p></div></div><div class="aside-bottom">Peterbilt Motors Company<span>Advanced Manufacturing Engineering Intern · 2026</span></div></aside>
  </section>
  <div class="credentials container"><div><strong>{profile.gpa}</strong><span>GPA</span></div><div><strong>{profile.graduation}</strong><span>Expected graduation</span></div><div><strong>CSWA</strong><span>SolidWorks certified</span></div><div><strong>Mathematics</strong><span>Minor</span></div></div>
  <section class="section container" id="work"><div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2>Engineering, made tangible.</h2></div><a class="text-link" href={href('work/')}>All work <span aria-hidden="true">↗</span></a></div><div class="project-grid featured-grid">{selected.map((project,index) => <ProjectCard project={project} index={index} />)}</div></section>
  <section class="section experience-section" id="experience"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / Experience</p><h2>From the shop floor<br />to the engineering team.</h2></div></div><div class="experience-list">{profile.experience.map((job,index) => <article class:list={['experience-item', {'primary-experience': index === 0}]}><div class="experience-meta"><p class="eyebrow">{job.date}</p>{job.location && <p>{job.location}</p>}</div><div><h3>{job.company}</h3><p class="job-role">{job.role}</p><ul>{job.points.map(point => <li>{point}</li>)}</ul>{job.project && <a class="text-link" href={href(`work/${job.project}/`)}>Explore the internship <span aria-hidden="true">↗</span></a>}</div></article>)}</div></div></section>
  <section class="section container about-section" id="about"><div><p class="eyebrow">03 / About</p><h2>Ideas become <br />more interesting <br />when you build them.</h2><div class="education"><span class="eyebrow">Education</span><h3>{profile.university}</h3><p>{profile.degree}</p><p>Minor in {profile.minor}<br />Expected {profile.graduation} · GPA {profile.gpa}</p></div></div><div class="about-copy">{profile.bio.map(p => <p>{p}</p>)}<a class="text-link" href="#contact">Let's talk engineering <span aria-hidden="true">↗</span></a></div></section>
  <section class="container skills-section" id="skills"><div class="section-heading"><div><p class="eyebrow">Tools & capabilities</p><h2>What I work with.</h2></div></div><div class="skills-grid">{profile.skills.map(group => <div><h3>{group.category}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div></section>
  <section class="section container leadership-section"><div class="section-heading"><div><p class="eyebrow">Beyond project work</p><h2>Leadership & involvement.</h2></div></div><div class="leadership-grid">{profile.leadership.map(item => <article><p class="eyebrow">{item.date}</p><h3>{item.name}</h3><p class="leadership-role">{item.role}</p><p>{item.detail}</p></article>)}</div></section>
  <section class="contact-section" id="contact"><div class="container contact-inner"><div><p class="eyebrow">04 / Contact</p><h2>Let's build<br />what comes next.</h2><p>Interested in design, manufacturing, and engineering internship opportunities.</p></div><div class="contact-links"><a href={`mailto:${profile.email}`}><span>Email</span><strong>{profile.email}</strong><span aria-hidden="true">↗</span></a><a href={`tel:${profile.phoneLink}`}><span>Phone</span><strong>{profile.phone}</strong><span aria-hidden="true">↗</span></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><span>Connect</span><strong>LinkedIn<span class="sr-only"> (opens in a new tab)</span></strong><span aria-hidden="true">↗</span></a><a href={href('resume.pdf')} target="_blank" rel="noopener"><span>Resume</span><strong>View PDF<span class="sr-only"> (opens in a new tab)</span></strong><span aria-hidden="true">↗</span></a></div></div></section>
</Base>
