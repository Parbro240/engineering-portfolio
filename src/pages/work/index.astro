---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {projects} from '../../lib/content';
const all = await projects();
---
<Base title="Engineering projects & experience | Parker Cole" description="Explore Parker Cole's custom putter prototypes, Peterbilt manufacturing experience, AI-assisted drawing tool, and developing putter performance research.">
  <div class="container"><header class="page-heading"><p class="eyebrow orange">Design / Manufacturing / Research</p><h1>Selected engineering work<span class="orange">.</span></h1><p>Personal prototypes, professional engineering experience, and questions worth investigating.</p></header><div class="project-grid all-work">{all.map((project,index) => <ProjectCard project={project} index={index} />)}</div></div>
</Base>
