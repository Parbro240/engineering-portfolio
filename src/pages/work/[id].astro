---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import {projects, href} from '../../lib/content';
export async function getStaticPaths(){ return (await projects()).map(project => ({params: {id: project.id}, props: {project}})); }
interface Props {project: CollectionEntry<'projects'>;}
const {project} = Astro.props;
const p = project.data;
const {Content, headings} = await render(project);
const all = await projects();
const next = all[(all.findIndex(item => item.id === project.id)+1)%all.length];
---
<Base title={`${p.title} | Parker Cole`} description={p.subtitle}>
  <article class="container case-study"><header class="case-heading"><a class="back-link" href={href('work/')}>← All Projects</a><p class="eyebrow orange">{p.categories.join(' · ')}</p><h1>{p.title}</h1><p class="case-subtitle">{p.subtitle}</p><span class="status-label">{p.status}</span></header>
  <dl class="project-facts"><div><dt>Role</dt><dd>{p.role}</dd></div><div><dt>Context</dt><dd>{p.type}</dd></div><div><dt>Timeline</dt><dd>{p.date}</dd></div><div><dt>Tools and Methods</dt><dd>{p.tools.join(' · ')}</dd></div></dl>
  {p.confidential && <aside class="confidentiality"><p>Certain project details have been generalized or omitted to protect proprietary information.</p></aside>}
  {(p.coverImage || p.metric || !p.confidential) && <div class="case-visual"><ProjectVisual src={p.coverImage} alt={p.coverAlt} placeholder={p.coverPlaceholder} metric={p.metric} /></div>}
  <div class="case-body"><aside class="case-toc"><nav aria-label="On this page"><span class="eyebrow">In This Case Study</span>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside><div class="prose"><Content /></div></div>
  <Gallery items={p.gallery} />
  <div class="case-bottom"><a class="text-link" href={href('work/')}>← All Projects</a>{next && next.id !== project.id && <a class="next-project" href={href(`work/${next.id}/`)}><span class="eyebrow">Next Case Study</span><strong>{next.data.title} <span aria-hidden="true">↗</span></strong></a>}</div>
  </article>
</Base>
